# ============================================================
# Frontend env (Vercel / production)
# ============================================================

# Адреса развёрнутых контрактов в Sepolia
# Получить после `npx hardhat run scripts/deploy.js --network sepolia`
VITE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Сеть для production (Sepolia chainId = 11155111)
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia
VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Standalone-режим: true = только blockchain (без backend, без Login/Register/Dashboard/Profile)
# false = полный стек (требует backend на :3001)
VITE_STANDALONE=true

# URL backend (только для VITE_STANDALONE=false)
VITE_BACKEND_URL=
